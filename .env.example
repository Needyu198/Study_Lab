# PostgreSQL connection string supplied by Neon, Supabase, or another provider.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Added automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Enables browser-to-Blob uploads instead of local base64 uploads.
VITE_BLOB_UPLOADS=true
