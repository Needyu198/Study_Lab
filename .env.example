# PostgreSQL connection string supplied by Neon, Supabase, or another provider.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Added automatically when a private Vercel Blob store is connected with OIDC.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# Enables browser-to-Blob uploads instead of local base64 uploads.
VITE_BLOB_UPLOADS=true
